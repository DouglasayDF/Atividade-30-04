                  "  if (json.ticker) pm.collectionVariables.set('tickerUS', json.ticker);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ticker\": \"AAPL\",\n  \"mercado\": \"US\",\n  \"corretoraId\": {{corretoraId}}\n}"
            },
            "url": "{{baseUrl}}/acoes"
          }
        },
        {
          "name": "Listar ações cadastradas",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/acoes"
          }
        },
        {
          "name": "Pesquisar ações na Brapi",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/acoes/brapi/list?search=PETR&limit=10&page=1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "acoes",
                "brapi",
                "list"
              ],
              "query": [
                {
                  "key": "search",
                  "value": "PETR"
                },
                {
                  "key": "limit",
                  "value": "10"
                },
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "sortBy",
                  "value": "stock",
                  "disabled": true
                },
                {
                  "key": "sortOrder",
                  "value": "asc",
                  "disabled": true
