                {
                  "key": "sector",
                  "value": "",
                  "disabled": true
                },
                {
                  "key": "type",
                  "value": "",
                  "disabled": true
                },
                {
                  "key": "subType",
                  "value": "",
                  "disabled": true
                },
                {
                  "key": "token",
                  "value": "",
                  "disabled": true
                }
              ]
            },
            "description": "Os parâmetros são opcionais e encaminhados para a Brapi. Token pode ser necessário conforme o uso da API externa."
          }
        },
        {
          "name": "Buscar ação por ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/acoes/{{acaoIdBR}}"
          }
        },
        {
          "name": "Buscar ação por ticker",
          "request": {
            "method": "GET",
            "header": [],
