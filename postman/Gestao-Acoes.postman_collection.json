          }
        },
        {
          "name": "Atualizar cotação",
          "request": {
            "method": "PUT",
            "header": [],
            "url": "{{baseUrl}}/acoes/{{acaoIdBR}}/atualizar-cotacao",
            "description": "Não possui body. Salva a cotação anterior no histórico, limitado aos cinco registros mais recentes."
          }
        },
        {
          "name": "Consultar histórico da cotação",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/acoes/{{acaoIdBR}}/historico"
