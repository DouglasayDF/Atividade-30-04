  "item": [
    {
      "name": "Status",
      "item": [
        {
          "name": "Testar API",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/teste",
            "description": "Deve responder com o texto: ok"
          }
        }
      ]
    },
    {
      "name": "Corretoras",
      "item": [
        {
          "name": "Listar corretoras padrão",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/corretoras/padrao"
          }
        },
        {
          "name": "Cadastrar corretoras padrão",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/corretoras/padrao",
            "description": "Cadastra apenas as corretoras padrão que ainda não existem."
          }
        },
        {
          "name": "Cadastrar corretora",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "  const json = pm.response.json();",
                  "  if (json.id) pm.collectionVariables.set('corretoraId', json.id);",
                  "  if (json.cnpj) pm.collectionVariables.set('cnpj', json.cnpj);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cnpj\": \"{{cnpj}}\",\n  \"cep\": \"{{cep}}\",\n  \"numero\": \"122\",\n  \"complemento\": \"Sala 12\"\n}"
            },
            "url": "{{baseUrl}}/corretoras",
            "description": "O CNPJ deve ter 14 dígitos, o CEP 8 dígitos e ambos precisam existir nas APIs externas. Use um CNPJ ainda não cadastrado."
          }
        },
        {
          "name": "Listar corretoras",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/corretoras"
          }
        },
        {
          "name": "Buscar corretora por ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/corretoras/{{corretoraId}}"
          }
        },
        {
          "name": "Buscar corretora por CNPJ",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/corretoras/cnpj/{{cnpj}}"
          }
        },
        {
          "name": "Validar corretora",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/corretoras/{{corretoraId}}/validacao"
          }
        }
      ]
    },
    {
      "name": "Ações",
      "item": [
        {
          "name": "Cadastrar ação brasileira",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "  const json = pm.response.json();",
                  "  if (json.id) pm.collectionVariables.set('acaoIdBR', json.id);",
                  "  if (json.ticker) pm.collectionVariables.set('tickerBR', json.ticker);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ticker\": \"PETR4\",\n  \"mercado\": \"BR\",\n  \"corretoraId\": {{corretoraId}}\n}"
            },
            "url": "{{baseUrl}}/acoes",
            "description": "Ticker de exemplo da B3. O sistema também consegue inferir o mercado pelo formato do ticker."
          }
        },
        {
          "name": "Cadastrar ação americana",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
