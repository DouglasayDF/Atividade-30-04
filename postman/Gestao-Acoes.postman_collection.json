    {
      "name": "Operações da carteira",
      "item": [
        {
          "name": "Comprar ação brasileira",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "  const json = pm.response.json();",
                  "  if (json.id) pm.collectionVariables.set('compraOperacaoId', json.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"acaoId\": {{acaoIdBR}},\n  \"usuarioId\": {{usuarioId}},\n  \"tipo\": \"COMPRA\",\n  \"quantidade\": 10,\n  \"precoUnitario\": 32.50\n}"
            },
            "url": "{{baseUrl}}/operacoes",
            "description": "Exige saldo BRL suficiente. O ID retornado é salvo em compraOperacaoId para o exemplo de venda."
          }
        },
        {
          "name": "Comprar ação americana",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"acaoId\": {{acaoIdUS}},\n  \"usuarioId\": {{usuarioId}},\n  \"tipo\": \"COMPRA\",\n  \"quantidade\": 2,\n  \"precoUnitario\": 250.00\n}"
            },
            "url": "{{baseUrl}}/operacoes",
            "description": "Exige saldo USD suficiente."
          }
        },
        {
          "name": "Vender uma compra",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"acaoId\": {{acaoIdBR}},\n  \"usuarioId\": {{usuarioId}},\n  \"tipo\": \"VENDA\",\n  \"quantidade\": 10,\n  \"precoUnitario\": 41.22,\n  \"compraOrigemId\": {{compraOperacaoId}}\n}"
            },
            "url": "{{baseUrl}}/operacoes",
            "description": "compraOrigemId é o ID da operação do tipo COMPRA retornada por POST /operacoes. Não é o ID retornado por POST /compras."
          }
        },
        {
          "name": "Listar todas as operações",
          "request": {
            "method": "GET",
